# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/courtduo

# Sent as part of the scraper's User-Agent header so PZT can contact us
SCRAPER_CONTACT_EMAIL=

# Default interface language
DEFAULT_LANG=pl

# Optional: a scratch Postgres database for running the DB-dependent
# tests (tests/test_registration_db.py). Never point this at the
# production database — tests create and drop tables. Tests that need it
# skip cleanly when this is unset.
TEST_DATABASE_URL=
