# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/courtduo

# Sent as part of the scraper's User-Agent header so PZT can contact us
SCRAPER_CONTACT_EMAIL=

# Default interface language
DEFAULT_LANG=pl

# Optional: a scratch Postgres database for running the DB-dependent
# tests (tests/test_registration_db.py). Never point this at the
# production database — tests create and drop tables. Tests that need it
# skip cleanly when this is unset.
TEST_DATABASE_URL=

# Read-only viewers (CLAUDE.md, "Identity", step 10): a test feature,
# allowlisted by PZT id. Comma-separated PZT ids allowed to see the
# Podgląd option and create viewer invite tokens, e.g. "ABC1234,XYZ5678".
# Never populate this in a committed file — these would identify real
# children in a public repository (CLAUDE.md rule 4).
VIEWER_ALLOWLIST_PZT_IDS=
