[Unit]
Description=CourtDuo tournament scraper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=courtduo
Group=courtduo
WorkingDirectory=/opt/courtduo
ExecStart=/opt/courtduo/venv/bin/python -m scrapers.tournaments
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/courtduo
